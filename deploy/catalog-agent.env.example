DATABASE_URL=postgresql://spottex:CHANGE_ME@127.0.0.1:5432/spottex
CATALOG_ARCHIVE_DIR=/var/lib/spottex/catalog-archive
CATALOG_AGENT_ALLOWED_HOSTS=cez.cz,www.cez.cz,cezdistribuce.cz,www.cezdistribuce.cz,eru.gov.cz,www.eru.gov.cz,ote-cr.cz,www.ote-cr.cz,eon.cz,www.eon.cz,pre.cz,www.pre.cz,novazelenausporam.cz,www.novazelenausporam.cz,sfzp.cz,www.sfzp.cz,csas.cz,www.csas.cz,csob.cz,www.csob.cz,kb.cz,www.kb.cz
# CODEX_HOME must point to a read-only directory containing machine auth only.
CODEX_HOME=/etc/spottex/codex
