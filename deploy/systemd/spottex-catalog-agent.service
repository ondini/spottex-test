[Unit]
Description=SpotTEX audited energy catalog draft agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=spottex
Group=spottex
WorkingDirectory=/srv/spottex/current
EnvironmentFile=/etc/spottex/catalog-agent.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run catalog:agent
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/spottex/catalog-archive
UMask=0027
