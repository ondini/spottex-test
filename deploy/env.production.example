# The production template. Copy to the repository root as .env.production, replace
# every placeholder, and keep it out of git -- it is the file every production
# Compose command must be pointed at with --env-file .env.production.
POSTGRES_DB=spottex
POSTGRES_USER=spottex_owner
POSTGRES_PASSWORD=replace-with-a-long-random-owner-password
POSTGRES_APP_USER=spottex_app
POSTGRES_APP_PASSWORD=replace-with-a-different-long-app-password
POSTGRES_BACKUP_USER=spottex_backup
POSTGRES_BACKUP_PASSWORD=replace-with-a-different-long-backup-password
DATABASE_ADMIN_URL=postgresql://spottex_owner:replace-with-url-encoded-owner-password@db:5432/spottex?schema=public
DATABASE_URL=postgresql://spottex_app:replace-with-url-encoded-app-password@db:5432/spottex?schema=public
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-separate-long-backup-encryption-passphrase

APP_URL=https://spottex.cz
AUTH_URL=https://spottex.cz
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
INTERNAL_JOB_TOKEN=replace-with-at-least-32-random-characters
ENERGY_INVOICE_AI_ENABLED=true
# Parser faktur drží Codex přihlášení a zůstává na stroji, který ho vlastní.
# Tady vyplňte jen adresu uvnitř WireGuard tunelu a token (min. 32 znaků);
# koordinátor se bez tokenu na jinou než loopback adresu odmítne spustit.
# Příklad: http://10.8.0.2:3010
INVOICE_PARSER_URL=
INVOICE_PARSER_TOKEN=
# Následující dva řádky patří POUZE stroji, který parser skutečně provozuje
# (spouští se profilem: docker compose --profile invoice-parser up -d).
# INVOICE_PARSER_BIND=10.8.0.2
# INVOICE_PARSER_PUBLISH=10.8.0.2:3010
# CODEX_AUTH_FILE=/etc/spottex/codex/auth.json
DEV_AUTO_VERIFY_EMAIL=false
TRUST_PROXY_HEADERS=true

ADMIN_SEED_EMAIL=admin@spottex.cz
ADMIN_SEED_PASSWORD=replace-before-the-one-time-seed

EMAIL_FROM=Spottex <noreply@spottex.cz>
RESEND_API_KEY=
SMTP_HOST=smtp.example.cz
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password

PAYMENT_PROVIDER=FREE
FREE_ACCESS_MODE=true
NEXT_PUBLIC_FREE_ACCESS_MODE=true
GOPAY_API_URL=https://gate.gopay.cz/api
GOPAY_CLIENT_ID=replace-with-gopay-client-id
GOPAY_CLIENT_SECRET=replace-with-gopay-client-secret
GOPAY_GO_ID=1234567890

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Pokud Google Calendar zapínáte, nastavte všechny tři hodnoty najednou;
# redirect musí být https://spottex.cz/api/admin/google-calendar/callback.
GOOGLE_CALENDAR_REDIRECT_URI=

# Terminate TLS at an internal reverse proxy; do not send credentials to port 2086 over plaintext HTTP.
# URL a Fernet klíč nastavte vždy společně. Příklad URL: https://legacy-api.internal.spottex.cz
SPOTTEX_LEGACY_API_URL=
SPOTTEX_LEGACY_FERNET_KEY=
ALLOW_INSECURE_LEGACY_HTTP=false
ENERGY_SYNC_INTERVAL_MINUTES=5
GRIDLINK_API_URL=
GRIDLINK_API_TOKEN=
# Ceníky (katalog nákladů) běží na samostatném stroji a nejsou veřejné. Adresa
# musí mířit dovnitř WireGuard tunelu (přes VPS), nikdy na veřejný internet, a
# vždy s tokenem. Prázdná hodnota katalog jen vypne, aplikace běží dál.
# Příklad: http://10.8.0.2:3012/api/v1
COSTS_INTERNAL_API_URL=
COSTS_INTERNAL_API_KEY=
COSTS_CATALOG_SYNC_INTERVAL_MINUTES=360
# Use a dedicated read-only role; never reuse the backend owner/runtime role.
# Hostname musí být dosažitelné z kontejneru: buď služba `db` v tomto stacku,
# nebo adresa uvnitř WireGuard tunelu, pokud backend běží jinde.
SPOTTEX_BACKEND_DATABASE_URL=
MARKET_SYNC_INTERVAL_MINUTES=15
SPOTTEX_PROD_PORT=3005

# Token konkrétního remotely-managed Cloudflare Tunnelu. Nejde o obecný
# Cloudflare API token a patří pouze na produkční host.
CLOUDFLARE_TUNNEL_TOKEN=

META_CONVERSIONS_API_TOKEN=

ANALYTICS_RETENTION_DAYS=395
CONSENT_RETENTION_DAYS=1825
AUDIT_RETENTION_DAYS=730
CONSULTATION_PII_RETENTION_DAYS=730
EMAIL_OUTBOX_RETENTION_DAYS=7
FAILED_EMAIL_RETENTION_DAYS=30
ENERGY_INVOICE_RETENTION_DAYS=180
ANALYSIS_SCENARIO_TIMEOUT_MS=600000
ANALYSIS_MAX_SOLVER_CALLS=600
ANALYSIS_RUN_BUDGET_MS=2700000
ANALYSIS_STALE_LOCK_MS=3600000
ANALYSIS_MAX_CONCURRENT_JOBS=1
ANALYSIS_JOB_BATCH_LIMIT=1
ENERGY_SUPPLIER_MODE=COMPARISON_ONLY
PUBLIC_MEDIA_HOSTS=spottex.cz,www.spottex.cz
