{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "companyCode", "companyName", "title", "sourceUrl", "validFrom", "validTo", "dataJson"],
        "properties": {
          "kind": { "enum": ["SOURCE", "PRODUCT", "DISTRIBUTION", "FUNDING_GRANT", "FUNDING_LOAN"] },
          "companyCode": { "type": "string" },
          "companyName": { "type": "string" },
          "title": { "type": "string" },
          "sourceUrl": { "type": "string" },
          "validFrom": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:00:00\\.000Z$" },
          "validTo": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:00:00\\.000Z$" },
              { "type": "null" }
            ]
          },
          "dataJson": { "type": "string" }
        }
      }
    }
  }
}
