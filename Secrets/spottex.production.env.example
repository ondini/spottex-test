# Zkopírujte jako Secrets/spottex.production.env. Skutečný *.env se necommituje.
POSTGRES_DB=spottex
POSTGRES_USER=spottex_owner
POSTGRES_PASSWORD=GENERATED_INTERNAL_SECRET
POSTGRES_APP_USER=spottex_app
POSTGRES_APP_PASSWORD=GENERATED_INTERNAL_SECRET
POSTGRES_BACKUP_USER=spottex_backup
POSTGRES_BACKUP_PASSWORD=GENERATED_INTERNAL_SECRET
DATABASE_ADMIN_URL=postgresql://spottex_owner:GENERATED_INTERNAL_SECRET@db:5432/spottex?schema=public
DATABASE_URL=postgresql://spottex_app:GENERATED_INTERNAL_SECRET@db:5432/spottex?schema=public
BACKUP_ENCRYPTION_PASSPHRASE=GENERATED_INTERNAL_SECRET

APP_URL=https://spottex.cz
AUTH_URL=https://spottex.cz
AUTH_SECRET=GENERATED_INTERNAL_SECRET
APP_ENCRYPTION_KEY=GENERATED_BASE64_32_BYTE_SECRET
INTERNAL_JOB_TOKEN=GENERATED_INTERNAL_SECRET
DEV_AUTO_VERIFY_EMAIL=false
TRUST_PROXY_HEADERS=true

ADMIN_SEED_EMAIL=admin@spottex.cz
ADMIN_SEED_PASSWORD=GENERATED_INTERNAL_SECRET

EMAIL_FROM=Spottex <noreply@spottex.cz>
# DOPLNIT UŽIVATELEM: zvolte Resend, nebo SMTP.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=

PAYMENT_PROVIDER=FREE
FREE_ACCESS_MODE=true
NEXT_PUBLIC_FREE_ACCESS_MODE=true
GOPAY_API_URL=https://gw.sandbox.gopay.com/api
# DOPLNIT UŽIVATELEM: GoPay sandbox údaje.
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_GO_ID=

# DOPLNIT UŽIVATELEM: všechny tři Google hodnoty společně.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# DOPLNIT UŽIVATELEM: obě legacy hodnoty společně, produkční URL pouze HTTPS.
SPOTTEX_LEGACY_API_URL=
SPOTTEX_LEGACY_FERNET_KEY=
ALLOW_INSECURE_LEGACY_HTTP=false
ENERGY_SYNC_INTERVAL_MINUTES=5
GRIDLINK_API_URL=
GRIDLINK_API_TOKEN=
COSTS_INTERNAL_API_URL=http://costs-api:3012
COSTS_INTERNAL_API_KEY=
COSTS_CATALOG_SYNC_INTERVAL_MINUTES=360
# Dedicated SELECT-only role for control.ote_prices_15min.
SPOTTEX_BACKEND_DATABASE_URL=postgresql://spottex_market_reader:replace-with-url-encoded-password@spottex_prod-db-1:5432/spottex
MARKET_SYNC_INTERVAL_MINUTES=15
SPOTTEX_PROD_PORT=3005

META_CONVERSIONS_API_TOKEN=
ANALYTICS_RETENTION_DAYS=395
CONSENT_RETENTION_DAYS=1825
AUDIT_RETENTION_DAYS=730
CONSULTATION_PII_RETENTION_DAYS=730
EMAIL_OUTBOX_RETENTION_DAYS=7
FAILED_EMAIL_RETENTION_DAYS=30
PUBLIC_MEDIA_HOSTS=spottex.cz,www.spottex.cz
