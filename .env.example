# Application
APP_URL=http://localhost:3004
AUTH_URL=http://localhost:3004
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
INTERNAL_JOB_TOKEN=replace-with-at-least-32-random-characters
ENERGY_INVOICE_AI_ENABLED=false
# Mount only the machine auth file, never the operator's full Codex home.
CODEX_AUTH_FILE=/etc/spottex/codex/auth.json
DEV_AUTO_VERIFY_EMAIL=false
TRUST_PROXY_HEADERS=false

# Retention defaults can be overridden to match the approved privacy policy.
ANALYTICS_RETENTION_DAYS=395
CONSENT_RETENTION_DAYS=1825
AUDIT_RETENTION_DAYS=730
CONSULTATION_PII_RETENTION_DAYS=730
EMAIL_OUTBOX_RETENTION_DAYS=7
FAILED_EMAIL_RETENTION_DAYS=30
ENERGY_INVOICE_RETENTION_DAYS=180
ANALYSIS_SCENARIO_TIMEOUT_MS=600000
ANALYSIS_RUN_BUDGET_MS=2700000
ANALYSIS_STALE_LOCK_MS=3600000
ANALYSIS_MAX_CONCURRENT_JOBS=1
ANALYSIS_JOB_BATCH_LIMIT=1
ENERGY_SUPPLIER_MODE=COMPARISON_ONLY
PUBLIC_MEDIA_HOSTS=spottex.cz,www.spottex.cz

# Database (host development default; Compose overrides this internally)
DATABASE_URL=postgresql://spottex:spottex_dev@127.0.0.1:5435/spottex?schema=public

# First admin, used only by `npm run db:seed`
ADMIN_SEED_EMAIL=admin@spottex.cz
ADMIN_SEED_PASSWORD=change-me-before-seeding

# Email (Mailpit defaults for local development)
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Spottex <noreply@spottex.cz>
RESEND_API_KEY=

# Existing energy platform adapters (server-side only)
SPOTTEX_LEGACY_API_URL=http://127.0.0.1:2086
SPOTTEX_FORECAST_MODEL_VERSION=
SPOTTEX_LEGACY_FERNET_KEY=
# Optional encrypted history-v1 endpoint on the isolated legacy API. It must
# accept device_id, from and to and return verified 15-minute kWh intervals.
SPOTTEX_LEGACY_HISTORY_PATH=/history_intervals
# Read-only telemetry refresh cadence; the internal runner itself ticks every 30 s.
ENERGY_SYNC_INTERVAL_MINUTES=5
GRIDLINK_API_URL=http://127.0.0.1:45992
GRIDLINK_API_TOKEN=

# Independent read-only Costs data platform. The URL is fixed by deployment
# configuration; user input is never used to build an upstream URL.
COSTS_INTERNAL_API_URL=http://costs-api:3012
COSTS_INTERNAL_API_KEY=
COSTS_CATALOG_SYNC_INTERVAL_MINUTES=360
# Read-only PostgreSQL role with SELECT only on control.ote_prices_15min.
SPOTTEX_BACKEND_DATABASE_URL=
MARKET_SYNC_INTERVAL_MINUTES=15
SPOTTEX_DEV_PORT=3004
SPOTTEX_PROD_PORT=3005

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3004/api/admin/google-calendar/callback

# Optional payment provider. Development uses the deterministic MOCK provider.
PAYMENT_PROVIDER=MOCK
FREE_ACCESS_MODE=true
NEXT_PUBLIC_FREE_ACCESS_MODE=true
GOPAY_API_URL=https://gw.sandbox.gopay.com/api
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_GO_ID=

# Analytics / Meta Pixel. Pixel stays disabled until consent is granted.
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
