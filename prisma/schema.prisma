  emailVerifiedAt      DateTime?
  calendarRevision     Int                       @default(0)
  consentAt            DateTime?
  clientIpHash         String?
  metadata             Json                      @default("{}")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  slot                 ConsultationSlot          @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@index([slotId, status])
  @@index([guestEmail, createdAt])
  @@index([status, createdAt])
  @@map("consultation_booking")
  @@schema("consultation")
}

model ConsultationHostCalendar {
  id                    Int       @id @default(autoincrement())
  hostUserId            Int       @unique
  googleEmail           String?
  encryptedAccessToken  String?   @db.Text
  encryptedRefreshToken String?   @db.Text
  tokenExpiresAt        DateTime?
  maskCalendarIds       String[]  @default([])
  targetCalendarId      String?
  autoMeet              Boolean   @default(true)
  timezone              String    @default("Europe/Prague")
  targetSlotsPerWeek    Int       @default(10)
  metadata              Json      @default("{}")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  host                  User      @relation(fields: [hostUserId], references: [id], onDelete: Cascade)

  @@map("consultation_host_calendar")
  @@schema("consultation")
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED

  @@schema("jobs")
}

model ScheduledJob {
  id             String    @id @default(cuid())
  type           String
  idempotencyKey String    @unique
  payload        Json      @default("{}")
  status         JobStatus @default(PENDING)
  runAt          DateTime
  attempts       Int       @default(0)
  lockedAt       DateTime?
  lastError      String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt])
  @@map("scheduled_job")
  @@schema("jobs")
}

model EmailOutbox {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique
  toEmail        String
  subject        String
  textBody       String    @db.Text
  htmlBody       String?   @db.Text
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  sendAt         DateTime  @default(now())
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, sendAt])
  @@map("email_outbox")
  @@schema("jobs")
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
  @@map("rate_limit_bucket")
  @@schema("jobs")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId Int?
  action      String
  entityType  String
  entityId    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
  @@schema("jobs")
}
