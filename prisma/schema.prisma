generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["analytics", "auth", "consultation", "content", "general", "jobs", "payment", "tariff"]
}

enum UserRole {
  USER
  ADMIN

  @@schema("general")
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING_VERIFICATION

  @@schema("general")
}

model User {
  id              Int        @id @default(autoincrement())
  email           String     @unique
  passwordHash    String
  name            String?
  phone           String?
  role            UserRole   @default(USER)
  status          UserStatus @default(PENDING_VERIFICATION)
  authVersion     Int        @default(0)
  emailVerifiedAt DateTime?
  avatarUrl       String?
  street          String?
  city            String?
  postalCode      String?
  country         String     @default("CZ")
  companyName     String?
  companyIdNumber String?
  vatId           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  emailVerifications    EmailVerification[]
  passwordResets        PasswordReset[]
  energyConnections     EnergyConnection[]
  energySites           EnergySite[]
  carts                 Cart[]
  payments              Payment[]
  subscriptions         Subscription[]            @relation("SubscriptionUser")
  activatedPromos       Subscription[]            @relation("SubscriptionActivator")
  invoices              Invoice[]
  analyticsEvents       AnalyticsEvent[]
  authoredPosts         BlogPost[]
  consultationSlots     ConsultationSlot[]
  consultationCalendar  ConsultationHostCalendar?
  auditEvents           AuditLog[]                @relation("AuditActor")
  confirmedEnergyFields EnergySiteFieldEvidence[] @relation("EnergyFieldConfirmer")
  serviceOffers         ServiceOffer[]
  recurringMandates     RecurringPaymentMandate[]
  recurringRenewals     RecurringRenewal[]
  energyAnalysisRuns    EnergyAnalysisRun[]
  confirmedPvArrays     EnergyPvArray[]           @relation("EnergyPvArrayConfirmer")
  invoiceExtractions    EnergyInvoiceExtraction[] @relation("EnergyInvoiceExtractionActor")

  @@map("users")
  @@schema("general")
}

model EmailVerification {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification")
  @@schema("auth")
}

model PasswordReset {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset")
  @@schema("auth")
}

enum EnergyProvider {
  LEGACY_SPOTTEX
  GRIDLINK
  DEMO

  @@schema("general")
}

enum ConnectionStatus {
  CONNECTED
  ACTION_REQUIRED
  DISCONNECTED
  ERROR

  @@schema("general")
}

model EnergyConnection {
  id                    Int              @id @default(autoincrement())
  userId                Int
  provider              EnergyProvider
  externalAccountId     String?
  encryptedAccessToken  String?          @db.Text
  encryptedRefreshToken String?          @db.Text
  tokenExpiresAt        DateTime?
  status                ConnectionStatus @default(CONNECTED)
  lastError             String?
  metadata              Json             @default("{}")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("energy_connection")
  @@schema("general")
}

enum EnergySiteStatus {
  ONLINE
  OFFLINE
  ONBOARDING
  ERROR

  @@schema("general")
}

model EnergySite {
  id                   Int                         @id @default(autoincrement())
  userId               Int
  provider             EnergyProvider
  externalSiteId       String
  name                 String
  status               EnergySiteStatus            @default(ONBOARDING)
  timezone             String                      @default("Europe/Prague")
  ean                  String?
  address              String?
  optimizationOn       Boolean                     @default(false)
  requiredInfo         Boolean                     @default(false)
  metadata             Json                        @default("{}")
  lastSyncedAt         DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inverters            Inverter[]
  technicalProfile     EnergySiteTechnicalProfile?
  fieldEvidence        EnergySiteFieldEvidence[]
  invoiceRequests      EnergyInvoiceRequest[]
  hdoCalendars         EnergyHdoCalendar[]
  priceCurves          EnergyPriceCurve[]
  serviceOffers        ServiceOffer[]
  subscriptions        Subscription[]
  analysisRuns         EnergyAnalysisRun[]
  pvArrays             EnergyPvArray[]
  controlledAppliances ControlledAppliance[]
  historyImports       EnergyHistoryImport[]

  @@unique([provider, externalSiteId])
  @@index([userId, status])
  @@map("energy_site")
  @@schema("general")
}

enum EnergyValueSource {
  SOLAX
  LEGACY_API
  EAN_LOOKUP
  INVOICE
  USER
  CATALOG
  MODEL
  ADMIN

  @@schema("general")
}

model EnergySiteTechnicalProfile {
  id                            Int        @id @default(autoincrement())
  energySiteId                  Int        @unique
  distributorCode               String?
  distributionTariffCode        String?
  phases                        Int?
  mainFuseA                     Float?
  maxGridInputKw                Float?
  maxGridOutputKw               Float?
  exportAllowed                 Boolean?
  pvCapacityKwp                 Float?
  batteryCapacityKwh            Float?
  batteryMaxChargeKw            Float?
  batteryMaxDischargeKw         Float?
  batteryMinSocPct              Float?
  batteryMaxSocPct              Float?
  batteryRoundtripEfficiencyPct Float?
  buyPricingMode                String?
  sellPricingMode               String?
  currentSupplierName           String?
  currentProductName            String?
  monthlySupplierFeeCzk         Float?
  fixedBuyPriceCzkKwh           Float?
  fixedSellPriceCzkKwh          Float?
  spotBuyFeeCzkKwh              Float?
  spotSellFeeCzkKwh             Float?
  fixedPriceValidUntil          DateTime?
  hdoStatus                     String?
  analysisConfirmedAt           DateTime?
  controlConfirmedAt            DateTime?
  legacySnapshot                Json       @default("{}")
  createdAt                     DateTime   @default(now())
  updatedAt                     DateTime   @updatedAt
  energySite                    EnergySite @relation(fields: [energySiteId], references: [id], onDelete: Cascade)

  @@map("energy_site_technical_profile")
  @@schema("general")
}

enum EnergyHistoryImportStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELED

  @@schema("general")
}

enum EnergyHistoryChunkStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("general")
}

model EnergyHistoryImport {
  id              String                     @id @default(cuid())
  energySiteId    Int
  inverterId      Int
  requestedFrom   DateTime
  requestedTo     DateTime
  status          EnergyHistoryImportStatus  @default(QUEUED)
  totalChunks     Int
  succeededChunks Int                        @default(0)
  failedChunks    Int                        @default(0)
  importedPoints  Int                        @default(0)
  lastError       String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  energySite      EnergySite                 @relation(fields: [energySiteId], references: [id], onDelete: Cascade)
  inverter        Inverter                   @relation(fields: [inverterId], references: [id], onDelete: Cascade)
  chunks          EnergyHistoryImportChunk[]

  @@index([energySiteId, status, createdAt])
  @@index([inverterId, createdAt])
  @@map("energy_history_import")
  @@schema("general")
}

model EnergyHistoryImportChunk {
  id             String                   @id @default(cuid())
  importId       String
  chunkFrom      DateTime
  chunkTo        DateTime
  status         EnergyHistoryChunkStatus @default(PENDING)
  attempts       Int                      @default(0)
  maxAttempts    Int                      @default(4)
  importedPoints Int                      @default(0)
  lastError      String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  historyImport  EnergyHistoryImport      @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, chunkFrom])
  @@index([status, updatedAt])
  @@map("energy_history_import_chunk")
  @@schema("general")
}

model EnergyPvArray {
  id                   Int               @id @default(autoincrement())
  energySiteId         Int
  inverterId           Int?
  name                 String
  panelCount           Int?
  panelRatedWp         Float?
  nominalDcCapacityKwp Float?
  active               Boolean           @default(true)
  source               EnergyValueSource @default(USER)
  sourceReference      String?
  observedAt           DateTime          @default(now())
  confirmedAt          DateTime?
  confirmedByUserId    Int?
  metadata             Json              @default("{}")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  energySite           EnergySite        @relation(fields: [energySiteId], references: [id], onDelete: Cascade)
  inverter             Inverter?         @relation(fields: [inverterId], references: [id], onDelete: SetNull)
  confirmedBy          User?             @relation("EnergyPvArrayConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@index([energySiteId, active])
  @@index([inverterId])
  @@map("energy_pv_array")
  @@schema("general")
}

enum ControlledApplianceType {
  HEAT_PUMP
  WATER_HEATER
  EV_CHARGER
  HVAC
  POOL
  OTHER

  @@schema("general")
}

enum ControlledApplianceStatus {
  DECLARED
  READY
  CONNECTED
  DISABLED

  @@schema("general")
}

model ControlledAppliance {
  id                Int                       @id @default(autoincrement())
  energySiteId      Int
  name              String
  type              ControlledApplianceType
  status            ControlledApplianceStatus @default(DECLARED)
  ratedPowerKw      Float?
  controllable      Boolean                   @default(false)
  minRuntimeMinutes Int?
  maxRuntimeMinutes Int?
  constraints       Json                      @default("{}")
  source            EnergyValueSource         @default(USER)
  sourceReference   String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  energySite        EnergySite                @relation(fields: [energySiteId], references: [id], onDelete: Cascade)

  @@index([energySiteId, status])
  @@map("controlled_appliance")
  @@schema("general")
}

model EnergySiteFieldEvidence {
  id                BigInt            @id @default(autoincrement())
  energySiteId      Int
  field             String
  value             Json
  source            EnergyValueSource
  sourceReference   String?
  observedAt        DateTime          @default(now())
  confirmedAt       DateTime?
  confirmedByUserId Int?
  createdAt         DateTime          @default(now())
  energySite        EnergySite        @relation(fields: [energySiteId], references: [id], onDelete: Cascade)
  confirmedBy       User?             @relation("EnergyFieldConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@index([energySiteId, field, observedAt])
  @@map("energy_site_field_evidence")
  @@schema("general")
}

enum EnergyInvoiceRequestStatus {
  REQUESTED
  RECEIVED
  PROCESSING
  NEEDS_INPUT
  CONFIRMED
  CANCELED

  @@schema("general")
}

model EnergyInvoiceRequest {
  id            String                     @id @default(cuid())
  energySiteId  Int
  referenceCode String                     @unique
  contactEmail  String                     @default("contact@spottex.cz")
  status        EnergyInvoiceRequestStatus @default(REQUESTED)
  receivedAt    DateTime?
  processedAt   DateTime?
  notes         String?                    @db.Text
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  energySite    EnergySite                 @relation(fields: [energySiteId], references: [id], onDelete: Cascade)
  documents     EnergyInvoiceDocument[]
  extractions   EnergyInvoiceExtraction[]

  @@index([energySiteId, status, createdAt])
  @@map("energy_invoice_request")
  @@schema("general")
}

model EnergyInvoiceDocument {
  id                String               @id @default(cuid())
  invoiceRequestId  String
  storageProvider   String
  storageKey        String
  encryptedContent  Bytes?
  encryptionVersion String               @default("AES_256_GCM_V1")
  originalFileName  String
  mimeType          String
  sizeBytes         Int
  contentSha256     String
  billingPeriodFrom DateTime?
  billingPeriodTo   DateTime?
  extractionVersion String?
  extractedData     Json                 @default("{}")
  sensitive         Boolean              @default(true)
  retainedUntil     DateTime
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  invoiceRequest    EnergyInvoiceRequest @relation(fields: [invoiceRequestId], references: [id], onDelete: Cascade)
  extractions       EnergyInvoiceExtraction[]

  @@unique([invoiceRequestId, contentSha256])
  @@index([retainedUntil, deletedAt])
  @@map("energy_invoice_document")
  @@schema("general")
}

model EnergyInvoiceExtraction {
  id               String                @id @default(cuid())
  invoiceRequestId String
  documentId       String?
  version          Int
  method           String                @default("MANUAL")
  schemaVersion    String                @default("energy-invoice-v1")
  billingPeriodFrom DateTime?
  billingPeriodTo  DateTime?
  extractedData    Json                  @default("{}")
  reviewedByUserId Int?
  createdAt        DateTime              @default(now())
  invoiceRequest   EnergyInvoiceRequest  @relation(fields: [invoiceRequestId], references: [id], onDelete: Cascade)
  document         EnergyInvoiceDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  reviewedBy       User?                 @relation("EnergyInvoiceExtractionActor", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([invoiceRequestId, version])
  @@index([documentId, createdAt])
  @@map("energy_invoice_extraction")
  @@schema("general")
}

enum CatalogPublicationStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  REJECTED
  ARCHIVED

  @@schema("tariff")
}

enum EnergyPricingMode {
  FIX
  SPOT
  TIME_CURVE

  @@schema("tariff")
}

model EnergyCompany {
  id                  Int                     @id @default(autoincrement())
  code                String                  @unique
  name                String
  websiteUrl          String?
  roles               String[]                @default([])
  active              Boolean                 @default(true)
  metadata            Json                    @default("{}")
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  products            EnergyProduct[]
  distributionTariffs DistributionTariff[]
  sourceDocuments     CatalogSourceDocument[]

  @@map("energy_company")
  @@schema("tariff")
}

model CatalogSourceDocument {
  id                   String                      @id @default(cuid())
  companyId            Int?
  kind                 String
  title                String
  sourceUrl            String
  contentSha256        String
  retrievedAt          DateTime                    @default(now())
  validFrom            DateTime?
  validTo              DateTime?
  status               CatalogPublicationStatus    @default(DRAFT)
  rawText              String?                     @db.Text
  metadata             Json                        @default("{}")
  reviewedAt           DateTime?
  reviewedBy           String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  company              EnergyCompany?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  productVersions      EnergyProductVersion[]
  distributionVersions DistributionTariffVersion[]
  fundingVersions      FundingProgramVersion[]

  @@unique([sourceUrl, contentSha256])
  @@index([kind, status, retrievedAt])
  @@map("catalog_source_document")
  @@schema("tariff")
}

enum FundingProgramKind {
  GRANT
  LOAN

  @@schema("tariff")
}

model FundingProgram {
  id           Int                     @id @default(autoincrement())
  code         String                  @unique
  name         String
  kind         FundingProgramKind
  providerName String
  officialUrl  String
  active       Boolean                 @default(true)
  metadata     Json                    @default("{}")
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  versions     FundingProgramVersion[]

  @@index([kind, active])
  @@map("funding_program")
  @@schema("tariff")
}

model FundingProgramVersion {
  id                    Int                      @id @default(autoincrement())
  fundingProgramId      Int
  sourceDocumentId      String
  validFrom             DateTime
  validTo               DateTime?
  status                CatalogPublicationStatus @default(DRAFT)
  territoryCodes        String[]                 @default([])
  customerSegments      String[]                 @default([])
  supportedTechnologies String[]                 @default([])
  minimumAmountCzk      Decimal?                 @db.Decimal(14, 2)
  maximumAmountCzk      Decimal?                 @db.Decimal(14, 2)
  subsidyRatePct        Decimal?                 @db.Decimal(7, 4)
  interestRatePct       Decimal?                 @db.Decimal(7, 4)
  aprPct                Decimal?                 @db.Decimal(7, 4)
  feesCzk               Decimal?                 @db.Decimal(14, 2)
  conditions            Json                     @default("{}")
  calculationFormula    Json                     @default("{}")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  fundingProgram        FundingProgram           @relation(fields: [fundingProgramId], references: [id], onDelete: Cascade)
  sourceDocument        CatalogSourceDocument    @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)

  @@unique([fundingProgramId, validFrom])
  @@index([status, validFrom, validTo])
  @@map("funding_program_version")
  @@schema("tariff")
}

model EnergyProduct {
  id              Int                    @id @default(autoincrement())
  supplierId      Int
  code            String
  name            String
  customerSegment String                 @default("HOUSEHOLD")
  active          Boolean                @default(true)
  metadata        Json                   @default("{}")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  supplier        EnergyCompany          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  versions        EnergyProductVersion[]

  @@unique([supplierId, code])
  @@index([customerSegment, active])
  @@map("energy_product")
  @@schema("tariff")
}

model EnergyProductVersion {
  id                Int                      @id @default(autoincrement())
  productId         Int
  sourceDocumentId  String?
  validFrom         DateTime
  validTo           DateTime?
  status            CatalogPublicationStatus @default(DRAFT)
  currency          String                   @default("CZK")
  vatIncluded       Boolean                  @default(true)
  buyMode           EnergyPricingMode
  sellMode          EnergyPricingMode
  monthlyFeeCzk     Decimal                  @default(0) @db.Decimal(14, 2)
  fixedBuyVtCzkKwh  Decimal?                 @db.Decimal(14, 6)
  fixedBuyNtCzkKwh  Decimal?                 @db.Decimal(14, 6)
  fixedSellVtCzkKwh Decimal?                 @db.Decimal(14, 6)
  fixedSellNtCzkKwh Decimal?                 @db.Decimal(14, 6)
  spotBuyFeeCzkKwh  Decimal?                 @db.Decimal(14, 6)
  spotSellFeeCzkKwh Decimal?                 @db.Decimal(14, 6)
  formula           Json                     @default("{}")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  product           EnergyProduct            @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceDocument    CatalogSourceDocument?   @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  buyPriceCurves    EnergyPriceCurve[]       @relation("BuyProductVersion")
  sellPriceCurves   EnergyPriceCurve[]       @relation("SellProductVersion")

  @@unique([productId, validFrom])
  @@index([status, validFrom, validTo])
  @@map("energy_product_version")
  @@schema("tariff")
}

model DistributionTariff {
  id              Int                         @id @default(autoincrement())
  distributorId   Int
  code            String
  name            String
  customerSegment String                      @default("HOUSEHOLD")
  eligibilityNote String?                     @db.Text
  active          Boolean                     @default(true)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  distributor     EnergyCompany               @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  versions        DistributionTariffVersion[]

  @@unique([distributorId, code, customerSegment])
  @@index([customerSegment, active])
  @@map("distribution_tariff")
  @@schema("tariff")
}

model DistributionTariffVersion {
  id                   Int                      @id @default(autoincrement())
  distributionTariffId Int
  sourceDocumentId     String?
  validFrom            DateTime
  validTo              DateTime?
  status               CatalogPublicationStatus @default(DRAFT)
  currency             String                   @default("CZK")
  vatIncluded          Boolean                  @default(true)
  distributionVtCzkKwh Decimal                  @db.Decimal(14, 6)
  distributionNtCzkKwh Decimal                  @db.Decimal(14, 6)
  systemServicesCzkKwh Decimal                  @default(0) @db.Decimal(14, 6)
  electricityTaxCzkKwh Decimal                  @default(0) @db.Decimal(14, 6)
  pozeCzkKwh           Decimal                  @default(0) @db.Decimal(14, 6)
  monthlyMeterFeeCzk   Decimal                  @default(0) @db.Decimal(14, 2)
  breakerFees          Json                     @default("{}")
  eligibility          Json                     @default("{}")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  distributionTariff   DistributionTariff       @relation(fields: [distributionTariffId], references: [id], onDelete: Cascade)
  sourceDocument       CatalogSourceDocument?   @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  priceCurves          EnergyPriceCurve[]

  @@unique([distributionTariffId, validFrom])
  @@index([status, validFrom, validTo])
  @@map("distribution_tariff_version")
  @@schema("tariff")
}

model MarketPriceSeries {
  id                String                   @id @default(cuid())
  code              String
  market            String
  currency          String                   @default("CZK")
  timezone          String                   @default("Europe/Prague")
  resolutionMinutes Int
  validFrom         DateTime
  validTo           DateTime
  sourceUrl         String?
  sourceSha256      String?
  status            CatalogPublicationStatus @default(DRAFT)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  points            MarketPricePoint[]
  priceCurves       EnergyPriceCurve[]

  @@unique([code, validFrom, resolutionMinutes])
  @@index([market, status, validFrom])
  @@map("market_price_series")
  @@schema("tariff")
}

model MarketPricePoint {
  id          BigInt            @id @default(autoincrement())
  seriesId    String
  startAt     DateTime
  endAt       DateTime
  priceCzkMwh Decimal           @db.Decimal(16, 6)
  predicted   Boolean           @default(false)
  series      MarketPriceSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, startAt])
  @@index([startAt])
  @@index([seriesId, predicted, startAt])
  @@map("market_price_point")
  @@schema("tariff")
}

enum HdoCalendarSource {
  DISTRIBUTOR
  USER
  INVOICE
  MODEL

  @@schema("general")
}

model EnergyHdoCalendar {
  id              String              @id @default(cuid())
  energySiteId    Int
  validFrom       DateTime
  validTo         DateTime
  source          HdoCalendarSource
  exact           Boolean             @default(false)
  confidencePct   Float?
  sourceReference String?
  eanSnapshot     String?
  distributorCode String?
  timezone        String              @default("Europe/Prague")
  retrievedAt     DateTime?
  verifiedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  energySite      EnergySite          @relation(fields: [energySiteId], references: [id], onDelete: Cascade)
  intervals       EnergyHdoInterval[]
  priceCurves     EnergyPriceCurve[]

  @@index([energySiteId, validFrom, validTo])
  @@index([eanSnapshot, distributorCode, validFrom, validTo])
  @@map("energy_hdo_calendar")
  @@schema("general")
}

model EnergyHdoInterval {
  id         BigInt            @id @default(autoincrement())
  calendarId String
  startAt    DateTime
  endAt      DateTime
  lowTariff  Boolean           @default(true)
  calendar   EnergyHdoCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, startAt])
  @@index([startAt, endAt])
  @@map("energy_hdo_interval")
  @@schema("general")
}

enum EnergyPriceCurveStatus {
  DRAFT
  READY
  INVALID
  SUPERSEDED

  @@schema("general")
}

model EnergyPriceCurve {
  id                    String                     @id @default(cuid())
  energySiteId          Int?
  buyProductVersionId   Int?
  sellProductVersionId  Int?
  distributionVersionId Int?
  marketPriceSeriesId   String?
  hdoCalendarId         String?
  fingerprint           String                     @unique
  purpose               String
  algorithmVersion      String
  timezone              String                     @default("Europe/Prague")
  resolutionMinutes     Int                        @default(15)
  validFrom             DateTime
  validTo               DateTime
  monthlyFixedCzk       Decimal                    @default(0) @db.Decimal(14, 2)
  status                EnergyPriceCurveStatus     @default(DRAFT)
  assumptions           Json                       @default("{}")
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  energySite            EnergySite?                @relation(fields: [energySiteId], references: [id], onDelete: Cascade)
  buyProductVersion     EnergyProductVersion?      @relation("BuyProductVersion", fields: [buyProductVersionId], references: [id], onDelete: Restrict)
  sellProductVersion    EnergyProductVersion?      @relation("SellProductVersion", fields: [sellProductVersionId], references: [id], onDelete: Restrict)
  distributionVersion   DistributionTariffVersion? @relation(fields: [distributionVersionId], references: [id], onDelete: Restrict)
  marketPriceSeries     MarketPriceSeries?         @relation(fields: [marketPriceSeriesId], references: [id], onDelete: Restrict)
  hdoCalendar           EnergyHdoCalendar?         @relation(fields: [hdoCalendarId], references: [id], onDelete: SetNull)
